<button aria-label="Bring photo to front" class="relative block h-32 w-36 appearance-none border-0 bg-transparent p-0 sm:h-36 sm:w-40 lg:ml-10 lg:h-40 lg:w-44" data-identity-mark type="button" transition:name="identity-mark" transition:persist>
	<span aria-hidden="true" class="portrait-photo absolute top-0 left-11 block size-24 transition-transform duration-300 ease-[cubic-bezier(0.2,0.8,0.2,1)] motion-reduce:transition-none sm:size-28 lg:size-32">
		<span class="block size-full transition-transform duration-300 ease-[cubic-bezier(0.2,0.8,0.2,1)] motion-reduce:transition-none">
			<img alt="" class="size-full rotate-15 rounded-full border border-border-strong object-cover opacity-95" decoding="sync" draggable="false" fetchpriority="high" height="388" loading="eager" src="/images/identity/me.webp" width="320" />
		</span>
	</span>
	<span aria-hidden="true" class="portrait-illustration absolute top-8 left-0 block size-24 transition-transform duration-300 ease-[cubic-bezier(0.2,0.8,0.2,1)] motion-reduce:transition-none sm:size-28 lg:size-32">
		<span class="block size-full transition-transform duration-300 ease-[cubic-bezier(0.2,0.8,0.2,1)] motion-reduce:transition-none">
			<img alt="" class="size-full -rotate-8 rounded-full border border-border-strong bg-background object-cover shadow-[0_0_0_5px_var(--background)]" decoding="sync" draggable="false" fetchpriority="high" height="320" loading="eager" src="/images/identity/me-anime.webp" width="320" />
		</span>
	</span>
</button>

<style>
	button[data-swapped] .portrait-photo {
		transform: translate(-2.75rem, 2rem);
		z-index: 1;
	}

	button[data-swapped] .portrait-illustration {
		transform: translate(2.75rem, -2rem);
	}

	button:not([data-swapped]):hover .portrait-photo > span,
	button[data-swapped]:hover .portrait-illustration > span {
		transform: translate(1.125rem, -1px);
	}

	button:not([data-swapped]):hover .portrait-illustration > span,
	button[data-swapped]:hover .portrait-photo > span {
		transform: translate(-0.625rem, 0.125rem);
	}
</style>

<script>
	let isSwapped = false;

	function updatePortrait(button: HTMLButtonElement) {
		button.toggleAttribute("data-swapped", isSwapped);
		button.setAttribute("aria-label", isSwapped ? "Bring illustrated portrait to front" : "Bring photo to front");
	}

	document.addEventListener("click", (event) => {
		if (!(event.target instanceof Element)) return;
		const button = event.target.closest<HTMLButtonElement>("[data-identity-mark]");
		if (!button) return;

		isSwapped = !isSwapped;
		updatePortrait(button);
	});

	document.addEventListener("astro:after-swap", () => {
		const button = document.querySelector<HTMLButtonElement>("[data-identity-mark]");
		if (button) updatePortrait(button);
	});
</script>
