---
const links = [
	{ href: "/", label: "Home" },
	{ href: "/work", label: "My Work" },
	{ href: "/contact", label: "Contact" },
] as const;

const pathname = Astro.url.pathname;
---

<nav aria-label="Primary navigation" class="pt-7 sm:pt-10 lg:pt-12">
	<ul class="m-0 flex list-none flex-col items-end gap-5 p-0 text-right font-oz-sans text-sm font-bold tracking-[-0.03em] text-muted sm:text-base">
		{links.map(({ href, label }) => (
			<li>
				<a
					aria-current={pathname === href ? "page" : undefined}
					class="inline-flex min-h-11 items-center whitespace-nowrap text-muted no-underline transition-[color,text-decoration-color] duration-150 ease-out hover:text-accent hover:underline hover:decoration-2 hover:decoration-accent hover:underline-offset-4 focus-visible:text-accent aria-[current=page]:text-accent aria-[current=page]:underline aria-[current=page]:decoration-2 aria-[current=page]:decoration-accent aria-[current=page]:underline-offset-4"
					href={href}
				>
					{label}
				</a>
			</li>
		))}
	</ul>
</nav>
