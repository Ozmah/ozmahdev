---
import IdentityMark from "../components/astro/IdentityMark.astro";
import PageContainer from "../components/astro/PageContainer.astro";
import SiteNavigation from "../components/astro/SiteNavigation.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { createPersonStructuredData } from "../lib/seo";

const description = "Personal site of Gabriel Alegría, mostly a web developer.";
---

<BaseLayout description={description} path="/" preloadIdentity title="OzmahDev | Gabriel Alegría">
	<script is:inline type="application/ld+json" set:html={JSON.stringify(createPersonStructuredData())}></script>
	<PageContainer variant="home">
		<header class="flex items-start justify-between gap-8">
			<IdentityMark />
			<SiteNavigation />
		</header>

		<section class="grid content-start pt-8 sm:pt-20 lg:pt-24">
			<div class="max-w-136">
				<h1 class="font-oz-display text-[clamp(1.35rem,1.16rem+0.8vw,1.9rem)] font-bold leading-tight tracking-[-0.04em] text-muted text-balance">Hi, I'm Gabriel. Mostly a web developer.</h1>
				<div class="mt-8 max-w-124 space-y-6 text-[clamp(1rem,0.96rem+0.18vw,1.125rem)] text-muted leading-[1.45] tracking-[-0.035em]">
					<p>I've been making software for a long time, e-commerce, banking, internal tooling and a lot more.</p>
					<p>I'm currently a full stack engineer at Internet Brands, working with the Content Team on backend systems, internal tooling, and platform improvements. Outside work, I'm building Consultapp, conjuring new ideas, and contributing to open source any chance I get.</p>
				</div>
				<div class="mt-12 sm:mt-20">
					<a class="group inline-flex min-h-15 min-w-48 cursor-pointer items-center justify-center gap-4 border border-accent bg-accent px-6 py-4 font-oz-action font-black text-[clamp(1rem,0.92rem+0.4vw,1.25rem)] text-background uppercase leading-none tracking-[0.02em] transition-[background-color,border-color,color,transform] duration-200 ease-out hover:-translate-y-px hover:border-accent-strong hover:bg-accent-strong" href="/work">
						<span>What I do</span>
						<span aria-hidden="true" class="inline-flex font-oz-mono text-[1.35em] leading-none transition-transform duration-150 ease-out group-hover:translate-x-1 motion-reduce:transform-none motion-reduce:transition-none">→</span>
					</a>
				</div>
			</div>
		</section>
	</PageContainer>
</BaseLayout>
