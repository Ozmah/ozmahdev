---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout noindex title="Not Found | OzmahDev">
	<div class="flex flex-1 items-center justify-center px-4 py-24">
		<div class="max-w-md text-center">
			<p class="font-medium text-muted text-sm">404</p>
			<h1 class="mt-3 font-semibold text-3xl tracking-tight">Not here</h1>
			<p class="mt-4 text-muted leading-7">The page you're looking for is in another web.</p>
			<a class="mt-8 inline-flex min-h-11 items-center justify-center rounded-xl bg-primary px-5 font-semibold text-primary-foreground text-sm no-underline focus-visible:outline-2 focus-visible:outline-primary focus-visible:outline-offset-2" href="/">Home</a>
		</div>
	</div>
</BaseLayout>
