---
import SitePageTitle from "../../components/astro/SitePageTitle.astro";
import BlogLayout from "../../layouts/BlogLayout.astro";

const description = "Notes on interfaces, experiments, and my work.";
---

<BlogLayout backHref="/" backLabel="Back to OzmahDev home" description={description} path="/blog" title="Blog | OzmahDev">
	<div class="max-w-3xl pb-20 sm:pb-28">
		<header class="border-border-strong border-b pb-8 sm:pb-10">
			<SitePageTitle text="My scratchpad" />
		</header>

		<ol class="m-0 list-none p-0">
			<li class="border-border border-b">
				<a class="group block py-8 text-inherit no-underline sm:py-10" href="/blog/canvas-from-ui-to-ux">
					<article class="grid gap-4 sm:grid-cols-[minmax(0,1fr)_auto] sm:gap-x-8">
						<div class="grid gap-2">
							<h2 class="m-0 max-w-[32ch] font-oz-display text-2xl tracking-[-0.04em] text-balance transition-colors duration-150 ease-out group-hover:text-accent group-focus-visible:text-accent">Canvas, from UI to UX</h2>
							<p class="m-0 max-w-[52ch] text-sm/6 text-muted text-pretty">How I'm stuffing my projects with good ux and bad pngs</p>
						</div>
						<time class="font-oz-mono text-sm/5 text-dim tabular-nums sm:pt-1 sm:text-right" datetime="2026-08-31">August 31, 2026</time>
					</article>
				</a>
			</li>
		</ol>
	</div>
</BlogLayout>
