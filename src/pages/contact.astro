---
import ContactLinks from "../components/astro/ContactLinks.astro";
import IdentityMark from "../components/astro/IdentityMark.astro";
import PageContainer from "../components/astro/PageContainer.astro";
import SiteNavigation from "../components/astro/SiteNavigation.astro";
import SitePageTitle from "../components/astro/SitePageTitle.astro";
import { siteConfig } from "../config/site";
import BaseLayout from "../layouts/BaseLayout.astro";

const description = `Contact ${siteConfig.owner} by email, GitHub, LinkedIn, Twitter, or Discord.`;
---

<BaseLayout description={description} path="/contact" preloadIdentity title={`Contact | ${siteConfig.name}`}>
	<PageContainer variant="home">
		<header class="flex items-start justify-between gap-8">
			<IdentityMark />
			<SiteNavigation />
		</header>
		<section class="grid content-start pt-16 sm:pt-20 lg:pt-24">
			<div class="max-w-136">
				<SitePageTitle text="Get in touch or find me online!" />
				<ContactLinks />
			</div>
		</section>
	</PageContainer>
</BaseLayout>
