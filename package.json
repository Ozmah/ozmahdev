{
	"name": "ozmah-dev",
	"private": true,
	"license": "MIT",
	"type": "module",
	"version": "0.0.1",
	"packageManager": "bun@1.4.0",
	"engines": {
		"node": "24.13.0"
	},
	"scripts": {
		"dev": "astro dev --port 3000",
		"glados": "bun run env:check && bun run secrets:scan && biome check . && bun run check-types && bun run test && bun run build",
		"env:check": "varlock load",
		"secrets:scan": "varlock scan",
		"build": "astro check && astro build && node scripts/verify-static-build.mjs",
		"check-types": "astro check",
		"test": "vitest run",
		"format": "biome format --write .",
		"lint": "biome lint .",
		"check": "biome check --write .",
		"preview": "astro preview",
		"astro": "astro",
		"prepare": "husky || true"
	},
	"dependencies": {
		"@astrojs/react": "6.0.4",
		"@fontsource/barlow-condensed": "5.3.0",
		"@fontsource/chakra-petch": "5.3.0",
		"@fontsource/plus-jakarta-sans": "5.3.0",
		"@phosphor-icons/react": "2.1.10",
		"@tailwindcss/vite": "4.3.3",
		"astro": "7.2.9",
		"motion": "12.43.0",
		"posthog-js": "1.422.5",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"tailwindcss": "4.3.3",
		"web-vitals": "5.3.0"
	},
	"allowScripts": {
		"esbuild": true
	},
	"devDependencies": {
		"@astrojs/check": "0.9.10",
		"@biomejs/biome": "2.5.11",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.5",
		"husky": "9.1.7",
		"typescript": "6.0.3",
		"varlock": "1.17.1",
		"vitest": "4.1.11"
	}
}
