{
  "name": "ozmah-dev",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "glados": "bun run env:check && bun run secrets:scan && biome check && bun run check-types && bun run test && bun run build",
    "env:check": "varlock load",
    "secrets:scan": "varlock scan",
    "build": "vite build",
    "preview": "vite preview",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check --write .",
    "start": "bun .output/server/index.mjs",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-devtools": "0.10.12",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-query-devtools": "5.102.8",
    "@tanstack/react-router": "1.170.32",
    "@tanstack/react-router-devtools": "1.167.1",
    "@tanstack/react-router-ssr-query": "1.167.2",
    "@tanstack/react-start": "1.168.49",
    "@tanstack/router-plugin": "1.168.35",
    "@varlock/infisical-plugin": "1.2.0",
    "motion": "12.43.0",
    "nitro": "npm:nitro-nightly@3.0.1-20260826-135133-65a4e394",
    "posthog-js": "1.422.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "4.3.3",
    "varlock": "1.17.1",
    "web-vitals": "5.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@tailwindcss/typography": "0.5.20",
    "@tanstack/devtools-vite": "0.8.5",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "husky": "9.1.7",
    "jsdom": "28.1.0",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "js-yaml": "4.3.2",
    "undici": "7.29.0",
    "ws": "8.21.3"
  }
